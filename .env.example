# Default engine: elevenlabs (paid API) or piper (free, local).
# CLI flag --engine overrides this.
ENGINE=elevenlabs

# ─── ElevenLabs (only needed if ENGINE=elevenlabs) ────────────────────────
# Get your API key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Browse voices and copy a voice_id: https://elevenlabs.io/app/voice-library
VOICE_ID=

# Optional default model.  Blank = eleven_multilingual_v2.
# Other options: eleven_flash_v2_5, eleven_turbo_v2_5
MODEL=

# ─── Piper (only needed if ENGINE=piper) ──────────────────────────────────
# Models live next to this script in voices/ — pass the .onnx path via
# --piper-model voices/en_US-amy-medium.onnx
# Catalog: https://github.com/rhasspy/piper/blob/master/VOICES.md
