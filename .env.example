# ElevenLabs paid xi-api-key.
# Get it at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Default voice_id used when --voice flag is not passed.
# Find voice IDs at: https://elevenlabs.io/app/voice-library
VOICE_ID=

# Optional default model.  Leave blank for eleven_multilingual_v2.
# Other options: eleven_flash_v2_5, eleven_turbo_v2_5
MODEL=
